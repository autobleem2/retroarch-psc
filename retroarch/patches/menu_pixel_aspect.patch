diff --git a/gfx/drivers/gl2.c b/gfx/drivers/gl2.c
index d39eb15..9e0cbcc 100644
--- a/gfx/drivers/gl2.c
+++ b/gfx/drivers/gl2.c
@@ -489,6 +489,50 @@ gfx_display_gl2_discard_draw_rectangle(gl2_t *gl,
 }
 #endif
 
+/* menu_pixel_aspect / menu_safe_margin: the menu, the widgets and the
+ * on-screen text are laid out in a virtual screen (video_driver_get_size()
+ * returns its size); this maps a rect of it, origin bottom-left, to real
+ * window pixels. A rect that spans the whole virtual width (height) is
+ * stretched to the window's edge on that axis, so wallpapers, the ribbon and
+ * the dimming still fill the margin. Identity with the default settings. */
+static void gl2_ui_map_rect(const gl2_t *gl,
+      float *x, float *y, float *w, float *h)
+{
+   float x1, y1, kx, ky;
+   video_ui_transform_t t;
+
+   video_driver_get_ui_transform(&t, gl->video_width, gl->video_height);
+   if (!t.active)
+      return;
+
+   kx = (float)t.sw / (float)t.vw;
+   ky = (float)t.sh / (float)t.vh;
+
+   if (*x <= 0.0f && *x + *w >= (float)t.vw)
+   {
+      *x = 0.0f;
+      *w = (float)gl->video_width;
+   }
+   else
+   {
+      x1 = roundf((float)t.sx + (*x + *w) * kx);
+      *x = roundf((float)t.sx + *x * kx);
+      *w = x1 - *x;
+   }
+
+   if (*y <= 0.0f && *y + *h >= (float)t.vh)
+   {
+      *y = 0.0f;
+      *h = (float)gl->video_height;
+   }
+   else
+   {
+      y1 = roundf((float)t.sy + (*y + *h) * ky);
+      *y = roundf((float)t.sy + *y * ky);
+      *h = y1 - *y;
+   }
+}
+
 static void gfx_display_gl2_draw(gfx_display_ctx_draw_t *draw,
       void *data, unsigned video_width, unsigned video_height)
 {
@@ -514,7 +558,14 @@ static void gfx_display_gl2_draw(gfx_display_ctx_draw_t *draw,
    if (!draw->coords->lut_tex_coord)
       draw->coords->lut_tex_coord = &gl2_tex_coords[0];
 
-   glViewport(draw->x, draw->y, draw->width, draw->height);
+   {
+      float vx = draw->x;
+      float vy = draw->y;
+      float vw = (float)draw->width;
+      float vh = (float)draw->height;
+      gl2_ui_map_rect(gl, &vx, &vy, &vw, &vh);
+      glViewport((GLint)vx, (GLint)vy, (GLsizei)vw, (GLsizei)vh);
+   }
    glBindTexture(GL_TEXTURE_2D, (GLuint)draw->texture);
 
    gl->shader->set_coords(gl->shader_data, draw->coords);
@@ -616,7 +667,13 @@ static void gfx_display_gl2_scissor_begin(
       int x, int y,
       unsigned width, unsigned height)
 {
-   glScissor(x, video_height - y - height, width, height);
+   float sx = (float)x;
+   float sy = (float)((int)video_height - y - (int)height);
+   float sw = (float)width;
+   float sh = (float)height;
+   if (data)
+      gl2_ui_map_rect((const gl2_t*)data, &sx, &sy, &sw, &sh);
+   glScissor((GLint)sx, (GLint)sy, (GLsizei)sw, (GLsizei)sh);
    glEnable(GL_SCISSOR_TEST);
 #ifdef MALI_BUG
    /* TODO/FIXME: If video width/height changes between
@@ -636,7 +693,12 @@ static void gfx_display_gl2_scissor_end(
       unsigned video_width,
       unsigned video_height)
 {
-   glScissor(0, 0, video_width, video_height);
+   const gl2_t *gl = (const gl2_t*)data;
+   /* The whole window; video_width/height are the virtual screen's */
+   if (gl)
+      glScissor(0, 0, gl->video_width, gl->video_height);
+   else
+      glScissor(0, 0, video_width, video_height);
    glDisable(GL_SCISSOR_TEST);
 #ifdef MALI_BUG
    scissor_set_rectangle(0, video_width - 1, 0, video_height - 1, 0);
@@ -1308,7 +1370,26 @@ static void gl2_set_viewport(gl2_t *gl,
       gl->vp.height = vp_height;
    }
 
-   glViewport(gl->vp.x, gl->vp.y, gl->vp.width, gl->vp.height);
+   if (force_full)
+   {
+      /* UI (text, menu texture): the safe area of the window, while
+       * gl->vp.width/height stay the virtual screen's, which is what
+       * the font code divides pixel sizes by */
+      video_ui_transform_t t;
+      video_driver_get_ui_transform(&t, gl->video_width, gl->video_height);
+      if (t.active)
+      {
+         gl->vp.x      = 0;
+         gl->vp.y      = 0;
+         gl->vp.width  = t.vw;
+         gl->vp.height = t.vh;
+         glViewport(t.sx, t.sy, t.sw, t.sh);
+      }
+      else
+         glViewport(gl->vp.x, gl->vp.y, gl->vp.width, gl->vp.height);
+   }
+   else
+      glViewport(gl->vp.x, gl->vp.y, gl->vp.width, gl->vp.height);
    gl2_set_projection(gl, &default_ortho, allow_rotate);
 
    /* Set last backbuffer viewport. */
@@ -3332,7 +3413,12 @@ static INLINE void gl2_draw_texture(gl2_t *gl)
 
    if (gl->flags & GL2_FLAG_MENU_TEXTURE_FULLSCREEN)
    {
-      glViewport(0, 0, width, height);
+      video_ui_transform_t t;
+      video_driver_get_ui_transform(&t, width, height);
+      if (t.active)
+         glViewport(t.sx, t.sy, t.sw, t.sh);
+      else
+         glViewport(0, 0, width, height);
       glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
       glViewport(gl->vp.x, gl->vp.y, gl->vp.width, gl->vp.height);
    }
@@ -4444,7 +4530,7 @@ static void *gl2_init(const video_info_t *video,
    if (temp_width != 0 && temp_height != 0)
       video_driver_set_size(temp_width, temp_height);
 
-   video_driver_get_size(&temp_width, &temp_height);
+   video_driver_get_physical_size(&temp_width, &temp_height);
    gl->video_width       = temp_width;
    gl->video_height      = temp_height;
 
diff --git a/gfx/video_driver.c b/gfx/video_driver.c
index 7917922..e02de82 100644
--- a/gfx/video_driver.c
+++ b/gfx/video_driver.c
@@ -1795,7 +1795,35 @@ void video_driver_set_filtering(unsigned index,
             index, smooth, ctx_scaling);
 }
 
-void video_driver_get_size(unsigned *width, unsigned *height)
+void video_driver_get_ui_transform(video_ui_transform_t *t,
+      unsigned width, unsigned height)
+{
+   settings_t *settings = config_get_ptr();
+   float par            = settings->floats.menu_pixel_aspect;
+   unsigned margin      = settings->uints.menu_safe_margin;
+
+   if (!(par >= 0.25f && par <= 4.0f))
+      par       = 1.0f;
+   if (margin > 25)
+      margin    = 25;
+
+   t->sx        = (unsigned)((float)width  * margin / 100.0f + 0.5f);
+   t->sy        = (unsigned)((float)height * margin / 100.0f + 0.5f);
+   t->sw        = width  - 2 * t->sx;
+   t->sh        = height - 2 * t->sy;
+   t->vw        = (unsigned)((float)t->sw * par + 0.5f);
+   t->vh        = t->sh;
+   t->active    = (par != 1.0f || margin != 0) && t->vw > 0 && t->vh > 0;
+   if (!t->active)
+   {
+      t->sx     = 0;
+      t->sy     = 0;
+      t->sw     = t->vw = width;
+      t->sh     = t->vh = height;
+   }
+}
+
+void video_driver_get_physical_size(unsigned *width, unsigned *height)
 {
    video_driver_state_t *video_st = &video_driver_st;
 #ifdef HAVE_THREADS
@@ -1812,6 +1840,19 @@ void video_driver_get_size(unsigned *width, unsigned *height)
 #endif
 }
 
+void video_driver_get_size(unsigned *width, unsigned *height)
+{
+   video_ui_transform_t t;
+   unsigned w, h;
+
+   video_driver_get_physical_size(&w, &h);
+   video_driver_get_ui_transform(&t, w, h);
+   if (width)
+      *width        = t.vw;
+   if (height)
+      *height       = t.vh;
+}
+
 void video_driver_set_size(unsigned width, unsigned height)
 {
    video_driver_state_t *video_st = &video_driver_st;
@@ -2985,8 +3026,13 @@ void video_driver_build_info(video_frame_info_t *video_info)
    video_info->widgets_userdata            = NULL;
 #endif
 
-   video_info->width                       = video_st->width;
-   video_info->height                      = video_st->height;
+   {
+      /* The menu's virtual screen, see video_driver_get_size() */
+      video_ui_transform_t ui;
+      video_driver_get_ui_transform(&ui, video_st->width, video_st->height);
+      video_info->width                    = ui.vw;
+      video_info->height                   = ui.vh;
+   }
    video_info->scale_width                 = video_st->scale_width;
    video_info->scale_height                = video_st->scale_height;
 
diff --git a/gfx/video_driver.h b/gfx/video_driver.h
index ca6434c..838e4e1 100644
--- a/gfx/video_driver.h
+++ b/gfx/video_driver.h
@@ -996,8 +996,28 @@ void video_driver_set_filtering(unsigned index, bool smooth, bool ctx_scaling);
 
 const char *video_driver_get_ident(void);
 
+/* The size the menu, the display widgets and the on-screen text are laid
+ * out for: the window, less menu_safe_margin on every side, with its width
+ * multiplied by menu_pixel_aspect. The window's own size is
+ * video_driver_get_physical_size(). */
 void video_driver_get_size(unsigned *width, unsigned *height);
 
+void video_driver_get_physical_size(unsigned *width, unsigned *height);
+
+/* Maps the virtual screen (vw x vh, square pixels) onto the safe area
+ * (sx, sy, sw, sh, window pixels, origin bottom-left) of a window of
+ * the given size. active is false (and vw x vh the window) when
+ * menu_pixel_aspect is 1 and menu_safe_margin 0. */
+typedef struct video_ui_transform
+{
+   unsigned sx, sy, sw, sh;
+   unsigned vw, vh;
+   bool active;
+} video_ui_transform_t;
+
+void video_driver_get_ui_transform(video_ui_transform_t *t,
+      unsigned width, unsigned height);
+
 void video_driver_set_size(unsigned width, unsigned height);
 
 float video_driver_get_aspect_ratio(void);
diff --git a/runloop.c b/runloop.c
