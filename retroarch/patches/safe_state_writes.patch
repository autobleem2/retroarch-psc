From: AutoBleem <autobleem@retromenele.pl>
Subject: [PATCH] task_save: save states and their pictures are written beside the name and renamed

RetroArch 1.22.2 writes a state straight into its final file name - content_auto_save_state() (the save on
the way out, which our launcher's slots are made from) and task_save_handler() (the Quick Menu's Save State) -
and the picture next to it the same way. A power cut, a pulled stick or a full FAT stick in the middle of
the write leaves a truncated .state/.state.auto where the last good one was, and the launcher would keep
that as a slot. Now the data goes to <name>.tmp and is renamed over <name> only when the whole write
succeeded; a failed write removes the .tmp and the old file stays as it was. The pictures (the silent
screenshots a save state asks for) do the same in task_screenshot_handler().
---
diff --git a/tasks/task_save.c b/tasks/task_save.c
index 343a7e2..fd63065 100644
--- a/tasks/task_save.c
+++ b/tasks/task_save.c
@@ -296,6 +296,28 @@ static void undo_save_state_cb(retro_task_t *task,
    free(state);
 }
 
+/* A state is written beside its final name and renamed into place when it is complete: a power cut or a full
+ * stick then never leaves a truncated state where the last good one was (the file is replaced, or untouched). */
+static void save_task_tmp_path(char *s, size_t len, const char *path)
+{
+   snprintf(s, len, "%s.tmp", path);
+}
+
+static void save_task_commit_tmp(const char *path, bool ok)
+{
+   char tmp[PATH_MAX_LENGTH];
+   save_task_tmp_path(tmp, sizeof(tmp), path);
+   if (!ok)
+   {
+      filestream_delete(tmp);
+      return;
+   }
+   if (filestream_exists(path))
+      filestream_delete(path);
+   if (filestream_rename(tmp, path))
+      RARCH_ERR("[State] Error renaming file \"%s\".\n", tmp);
+}
+
 /**
  * task_save_handler_finished:
  * @task : the task to finish
@@ -319,6 +341,8 @@ static void task_save_handler_finished(retro_task_t *task,
    if (!task_get_error(task) && ((flg & RETRO_TASK_FLG_CANCELLED) > 0))
       task_set_error(task, strdup("Task canceled"));
 
+   save_task_commit_tmp(state->path, !task_get_error(task));
+
    task_data = (save_task_state_t*)calloc(1, sizeof(*task_data));
    memcpy(task_data, state, sizeof(*state));
 
@@ -510,12 +534,14 @@ static void task_save_handler(retro_task_t *task)
 
    if (!state->file)
    {
+      char tmp[PATH_MAX_LENGTH];
+      save_task_tmp_path(tmp, sizeof(tmp), state->path);
       if (state->flags & SAVE_TASK_FLAG_COMPRESS_FILES)
          state->file   = intfstream_open_rzip_file(
-               state->path, RETRO_VFS_FILE_ACCESS_WRITE);
+               tmp, RETRO_VFS_FILE_ACCESS_WRITE);
       else
          state->file   = intfstream_open_file(
-               state->path, RETRO_VFS_FILE_ACCESS_WRITE,
+               tmp, RETRO_VFS_FILE_ACCESS_WRITE,
                RETRO_VFS_FILE_ACCESS_HINT_NONE);
 
       if (!state->file)
@@ -1333,6 +1359,7 @@ bool content_auto_save_state(const char *path)
    settings_t *settings = config_get_ptr();
    void *serial_data  = NULL;
    intfstream_t *file = NULL;
+   char tmp[PATH_MAX_LENGTH];
 
    if (!core_info_current_supports_savestate())
    {
@@ -1345,16 +1372,18 @@ bool content_auto_save_state(const char *path)
    if (_len == 0)
       return false;
 
+   save_task_tmp_path(tmp, sizeof(tmp), path);
+
    serial_data = content_get_serialized_data(&_len);
    if (!serial_data)
       return false;
 
 #if defined(HAVE_ZLIB)
    if (settings->bools.savestate_file_compression)
-      file = intfstream_open_rzip_file(path, RETRO_VFS_FILE_ACCESS_WRITE);
+      file = intfstream_open_rzip_file(tmp, RETRO_VFS_FILE_ACCESS_WRITE);
    else
 #endif
-      file = intfstream_open_file(path, RETRO_VFS_FILE_ACCESS_WRITE,
+      file = intfstream_open_file(tmp, RETRO_VFS_FILE_ACCESS_WRITE,
                                   RETRO_VFS_FILE_ACCESS_HINT_NONE);
 
    if (!file)
@@ -1368,12 +1397,14 @@ bool content_auto_save_state(const char *path)
       intfstream_close(file);
       free(serial_data);
       free(file);
+      save_task_commit_tmp(path, false);
       return false;
    }
 
    intfstream_close(file);
    free(serial_data);
    free(file);
+   save_task_commit_tmp(path, true);
 
 #ifdef HAVE_SCREENSHOTS
    if (settings->bools.savestate_thumbnail_enable)
diff --git a/tasks/task_screenshot.c b/tasks/task_screenshot.c
index 4c6457f..4d01d88 100644
--- a/tasks/task_screenshot.c
+++ b/tasks/task_screenshot.c
@@ -27,6 +27,7 @@
 #endif
 
 #include <file/file_path.h>
+#include <streams/file_stream.h>
 #include <compat/strl.h>
 #include <string/stdstring.h>
 #include <gfx/video_frame.h>
@@ -169,8 +170,32 @@ static void task_screenshot_handler(retro_task_t *task)
    if (task_get_progress(task) == 100)
       goto task_finished;
 
-   /* Take screenshot */
-   ret = screenshot_dump_direct(state);
+   /* Take screenshot. A save state's picture (the silent ones) is written beside its name and renamed when
+    * complete, like the state itself (task_save.c): no half-written picture next to a good state. */
+   if (state->flags & SS_TASK_FLAG_SILENCE)
+   {
+      char final_name[PATH_MAX_LENGTH];
+      size_t _len = strlcpy(final_name, state->filename, sizeof(final_name));
+      strlcpy(state->filename, final_name, sizeof(state->filename));
+      if (_len + 5 < sizeof(state->filename))
+         strlcat(state->filename, ".tmp", sizeof(state->filename));
+      ret = screenshot_dump_direct(state);
+      if (state->filename[_len])
+      {
+         if (ret)
+         {
+            if (filestream_exists(final_name))
+               filestream_delete(final_name);
+            if (filestream_rename(state->filename, final_name))
+               ret = false;
+         }
+         else
+            filestream_delete(state->filename);
+      }
+      strlcpy(state->filename, final_name, sizeof(state->filename));
+   }
+   else
+      ret = screenshot_dump_direct(state);
 
    /* Push screenshot to image history playlist */
 #ifdef HAVE_IMAGEVIEWER
