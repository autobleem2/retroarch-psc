 #if defined(HAVE_GFX_WIDGETS)
    if (widgets_active)
@@ -6301,11 +6306,15 @@ static enum runloop_state_enum runloop_check_state(
             if (BIT64_GET(menu->state, MENU_STATE_BLIT))
             {
                if (menu->driver_ctx->render)
+               {
+                  unsigned ui_width, ui_height;
+                  video_driver_get_size(&ui_width, &ui_height);
                   menu->driver_ctx->render(
                         menu->userdata,
-                        video_st->width,
-                        video_st->height,
+                        ui_width,
+                        ui_height,
                         (runloop_st->flags & RUNLOOP_FLAG_IDLE) ? true : false);
+               }
             }
 
             if (      (menu_st->flags & MENU_ST_FLAG_ALIVE)
